{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/blumepage/perfect-libraries/main/schema/perfect-libraries-v1.schema.json",
  "title": "Perfect Libraries manifest",
  "description": "A portable contract for promoting imported Figma frames into token-bound component libraries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "library",
    "tokenCollections",
    "components"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/blumepage/perfect-libraries/main/schema/perfect-libraries-v1.schema.json"
    },
    "version": {
      "const": 1
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "release"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 }
      }
    },
    "tokenCollections": {
      "type": "array",
      "items": { "$ref": "#/$defs/tokenCollection" }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "tokenCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "modes", "tokens"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/token" }
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "scopes", "values"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["COLOR", "FLOAT", "STRING", "BOOLEAN"]
        },
        "description": { "type": "string" },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "codeSyntax": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "WEB": { "type": "string" },
            "ANDROID": { "type": "string" },
            "iOS": { "type": "string" }
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/tokenValue" }
        }
      }
    },
    "tokenValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["alias"],
          "properties": {
            "alias": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["r", "g", "b"],
          "properties": {
            "r": { "type": "number", "minimum": 0, "maximum": 1 },
            "g": { "type": "number", "minimum": 0, "maximum": 1 },
            "b": { "type": "number", "minimum": 0, "maximum": 1 },
            "a": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "property", "token"],
      "properties": {
        "layer": { "type": "string" },
        "property": {
          "enum": [
            "fill",
            "stroke",
            "text-fill",
            "padding-top",
            "padding-right",
            "padding-bottom",
            "padding-left",
            "gap",
            "radius",
            "radius-top-left",
            "radius-top-right",
            "radius-bottom-right",
            "radius-bottom-left",
            "stroke-weight",
            "opacity",
            "font-size",
            "line-height",
            "letter-spacing"
          ]
        },
        "token": { "type": "string", "minLength": 1 },
        "paintIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "nestedInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "component"],
      "properties": {
        "layer": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "variant": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [{ "type": "string" }, { "type": "boolean" }]
          }
        }
      }
    },
    "componentProperty": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "layer", "defaultValue"],
          "properties": {
            "type": { "const": "TEXT" },
            "name": { "type": "string", "minLength": 1 },
            "layer": { "type": "string", "minLength": 1 },
            "defaultValue": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "layer", "defaultValue"],
          "properties": {
            "type": { "const": "BOOLEAN" },
            "name": { "type": "string", "minLength": 1 },
            "layer": { "type": "string", "minLength": 1 },
            "defaultValue": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "layer",
            "defaultComponent"
          ],
          "properties": {
            "type": { "const": "INSTANCE_SWAP" },
            "name": { "type": "string", "minLength": 1 },
            "layer": { "type": "string", "minLength": 1 },
            "defaultComponent": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceNode", "properties"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceNode": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        },
        "bindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/binding" }
        },
        "nestedInstances": {
          "type": "array",
          "items": { "$ref": "#/$defs/nestedInstance" }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "variants"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "documentationUrl": { "type": "string", "format": "uri" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentProperty" }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    }
  }
}
