{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/blumepage/perfect-libraries/main/schema/perfect-libraries-sources-v1.schema.json",
  "title": "Perfect Libraries Storybook Sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "library", "generatedAt", "variants"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/blumepage/perfect-libraries/main/schema/perfect-libraries-sources-v1.schema.json"
    },
    "version": { "const": 1 },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "release"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceNode", "scene"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceNode": { "type": "string", "minLength": 1 },
          "warnings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "scene": { "$ref": "#/$defs/sceneNode" }
        }
      }
    }
  },
  "$defs": {
    "paint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "color"],
          "properties": {
            "type": { "const": "SOLID" },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "color": { "$ref": "#/$defs/color" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "gradientTransform", "gradientStops"],
          "properties": {
            "type": { "const": "GRADIENT_LINEAR" },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "gradientTransform": { "$ref": "#/$defs/transform" },
            "gradientStops": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["position", "color"],
                "properties": {
                  "position": { "type": "number", "minimum": 0, "maximum": 1 },
                  "color": { "$ref": "#/$defs/rgba" }
                }
              }
            }
          }
        }
      ]
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "g", "b"],
      "properties": {
        "r": { "type": "number", "minimum": 0, "maximum": 1 },
        "g": { "type": "number", "minimum": 0, "maximum": 1 },
        "b": { "type": "number", "minimum": 0, "maximum": 1 },
        "a": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "rgba": {
      "allOf": [
        { "$ref": "#/$defs/color" },
        { "required": ["a"] }
      ]
    },
    "transform": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": { "type": "number" }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "color", "offset", "radius"],
      "properties": {
        "type": { "enum": ["DROP_SHADOW", "INNER_SHADOW"] },
        "color": { "$ref": "#/$defs/rgba" },
        "offset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "radius": { "type": "number", "minimum": 0 },
        "spread": { "type": "number" }
      }
    },
    "base": {
      "type": "object",
      "required": ["type", "name", "width", "height"],
      "properties": {
        "type": { "enum": ["FRAME", "TEXT", "RECTANGLE", "IMAGE", "VECTOR"] },
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "layoutPositioning": { "const": "ABSOLUTE" },
        "constraints": { "$ref": "#/$defs/constraints" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizontal", "vertical"],
      "properties": {
        "horizontal": { "enum": ["MIN", "CENTER", "MAX", "STRETCH", "SCALE"] },
        "vertical": { "enum": ["MIN", "CENTER", "MAX", "STRETCH", "SCALE"] }
      }
    },
    "sceneNode": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "required": ["layoutMode", "children"],
              "properties": {
                "type": { "const": "FRAME" },
                "layoutMode": { "enum": ["HORIZONTAL", "VERTICAL", "NONE"] },
                "primaryAxisSizingMode": { "enum": ["FIXED", "AUTO"] },
                "counterAxisSizingMode": { "enum": ["FIXED", "AUTO"] },
                "primaryAxisAlignItems": { "enum": ["MIN", "MAX", "CENTER", "SPACE_BETWEEN"] },
                "counterAxisAlignItems": { "enum": ["MIN", "MAX", "CENTER", "BASELINE"] },
                "layoutWrap": { "enum": ["NO_WRAP", "WRAP"] },
                "paddingTop": { "type": "number" },
                "paddingRight": { "type": "number" },
                "paddingBottom": { "type": "number" },
                "paddingLeft": { "type": "number" },
                "itemSpacing": { "type": "number" },
                "counterAxisSpacing": { "type": "number" },
                "cornerRadius": { "type": "number" },
                "topLeftRadius": { "type": "number" },
                "topRightRadius": { "type": "number" },
                "bottomRightRadius": { "type": "number" },
                "bottomLeftRadius": { "type": "number" },
                "fills": { "type": "array", "items": { "$ref": "#/$defs/paint" } },
                "strokes": { "type": "array", "items": { "$ref": "#/$defs/paint" } },
                "strokeWeight": { "type": "number" },
                "strokeTopWeight": { "type": "number" },
                "strokeRightWeight": { "type": "number" },
                "strokeBottomWeight": { "type": "number" },
                "strokeLeftWeight": { "type": "number" },
                "strokeAlign": { "enum": ["INSIDE", "CENTER", "OUTSIDE"] },
                "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
                "clipsContent": { "type": "boolean" },
                "children": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/sceneNode" }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "required": ["data", "mimeType"],
              "properties": {
                "type": { "const": "IMAGE" },
                "data": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9+/]+={0,2}$"
                },
                "mimeType": { "enum": ["image/png", "image/jpeg", "image/gif"] },
                "scaleMode": { "enum": ["FILL", "FIT"] },
                "cornerRadius": { "type": "number" },
                "topLeftRadius": { "type": "number" },
                "topRightRadius": { "type": "number" },
                "bottomRightRadius": { "type": "number" },
                "bottomLeftRadius": { "type": "number" },
                "strokes": { "type": "array", "items": { "$ref": "#/$defs/paint" } },
                "strokeWeight": { "type": "number" },
                "strokeTopWeight": { "type": "number" },
                "strokeRightWeight": { "type": "number" },
                "strokeBottomWeight": { "type": "number" },
                "strokeLeftWeight": { "type": "number" },
                "strokeAlign": { "enum": ["INSIDE", "CENTER", "OUTSIDE"] },
                "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "required": ["characters", "fontFamily", "fontStyle", "fontSize"],
              "properties": {
                "type": { "const": "TEXT" },
                "characters": { "type": "string" },
                "fontFamily": { "type": "string" },
                "fontStyle": { "type": "string" },
                "fontSize": { "type": "number" },
                "fontWeight": { "type": "number" },
                "lineHeight": { "type": "number" },
                "letterSpacing": { "type": "number" },
                "textAlignHorizontal": { "enum": ["LEFT", "CENTER", "RIGHT", "JUSTIFIED"] },
                "fills": { "type": "array", "items": { "$ref": "#/$defs/paint" } }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "properties": {
                "type": { "const": "RECTANGLE" },
                "cornerRadius": { "type": "number" },
                "topLeftRadius": { "type": "number" },
                "topRightRadius": { "type": "number" },
                "bottomRightRadius": { "type": "number" },
                "bottomLeftRadius": { "type": "number" },
                "fills": { "type": "array", "items": { "$ref": "#/$defs/paint" } },
                "strokes": { "type": "array", "items": { "$ref": "#/$defs/paint" } },
                "strokeWeight": { "type": "number" },
                "strokeTopWeight": { "type": "number" },
                "strokeRightWeight": { "type": "number" },
                "strokeBottomWeight": { "type": "number" },
                "strokeLeftWeight": { "type": "number" },
                "strokeAlign": { "enum": ["INSIDE", "CENTER", "OUTSIDE"] },
                "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/base" },
            {
              "type": "object",
              "required": ["svg"],
              "properties": {
                "type": { "const": "VECTOR" },
                "svg": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      ]
    }
  }
}
