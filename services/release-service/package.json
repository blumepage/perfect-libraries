{
  "name": "@perfect-libraries/release-service",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable release feed and Figma publication tracker for Perfect Libraries.",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:blume": "wrangler deploy --config deployments/blume/wrangler.jsonc",
    "dev": "wrangler dev --port 8787",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.111.0"
  }
}
