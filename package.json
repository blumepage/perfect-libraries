{
  "name": "perfect-libraries",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source Figma plugin that turns imported frames and portable manifests into maintainable component libraries.",
  "license": "MIT",
  "homepage": "https://www.figma.com/community/plugin/1662573031327668831",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blumepage/perfect-libraries.git"
  },
  "bugs": {
    "url": "https://github.com/blumepage/perfect-libraries/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.3",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "service:build": "pnpm --filter @perfect-libraries/release-service build",
    "service:dev": "pnpm --filter @perfect-libraries/release-service dev",
    "service:test": "pnpm --filter @perfect-libraries/release-service test",
    "service:typecheck": "pnpm --filter @perfect-libraries/release-service typecheck",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.131.0",
    "esbuild": "0.28.0",
    "typescript": "^5.9.3"
  }
}
